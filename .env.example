# No credentials needed for Offline demo + Session storage.
OPENAI_API_KEY=
MODEL_A_PROVIDER=typesafe
DEBUG_ERRORS=true
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
MODEL_A=jev-latest
MODEL_B=gpt-4o
# Required to unlock live AI or Supabase in the app. Choose a strong password.
APP_PASSWORD=
SUPABASE_URL=
# Server-only key. Never put this in browser JavaScript or commit .env.
SUPABASE_SERVICE_ROLE_KEY=
# Fill in verified current API prices; blank means cost unknown, never zero.
MODEL_A_INPUT_USD_PER_MILLION=
MODEL_A_OUTPUT_USD_PER_MILLION=
MODEL_B_INPUT_USD_PER_MILLION=
MODEL_B_OUTPUT_USD_PER_MILLION=
